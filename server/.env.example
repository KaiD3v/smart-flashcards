# Postgres local (ajusta host/porta conforme a tua instância).
DATABASE_URL="postgresql://root:root@localhost:5432/app_db"
PORT=3000
NODE_ENV=development
JWT_SECRET=secret
JWT_EXPIRES_IN=1h
JWT_COOKIE_MAX_AGE_MS=3600000
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SAME_SITE=lax

# LLM: `ollama` (default) or `groq`
LLM_PROVIDER=ollama

# OLLAMA (when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_API_KEY=sk-proj-1234567890

# GROQ (when LLM_PROVIDER=groq)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# CORS ORIGINS

# Allowed frontend origin(s), separated by commas.
WEB_ORIGIN=http://localhost:3001
# Backward-compatible fallback key for older config.
CORS_ORIGIN=http://localhost:3001

# Mail: smtp (default) | mailtrap
# MAIL_PROVIDER=mailtrap

# SMTP genérico (Ethereal, Brevo, etc.)
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_FROM=
MAIL_FRONTEND_URL=http://localhost:3001

# Mailtrap SDK — crie em https://mailtrap.io/api-tokens (não use senha SMTP da Integration)
# Permissões necessárias: Email Sandbox (inbox) ou Sending (produção)
# MAILTRAP_API_TOKEN=
# MAILTRAP_USE_SANDBOX=true
# ID numérico da inbox (Sandboxes → sua inbox → Integration), não confundir com SMTP user
# MAILTRAP_INBOX_ID=

# Review reminder emails (cron in server process)
REVIEW_REMINDER_ENABLED=true
# Daily time HH:MM (used when REVIEW_REMINDER_CRON is not set)
REVIEW_REMINDER_TIME=08:00
# Optional full cron (overrides REVIEW_REMINDER_TIME), e.g. 01:32 → 32 1 * * *
# REVIEW_REMINDER_CRON=32 1 * * *
REVIEW_REMINDER_TIMEZONE=America/Sao_Paulo
# Testes: ignora limite de 1 e-mail/dia (não usar em produção)
# REVIEW_REMINDER_SKIP_DEDUPE=true