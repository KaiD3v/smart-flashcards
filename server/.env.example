# Postgres local (ajusta host/porta conforme a tua instância).
DATABASE_URL="postgresql://root:root@localhost:5432/app_db"
PORT=3000
NODE_ENV=development
JWT_SECRET=secret
JWT_EXPIRES_IN=1h
JWT_COOKIE_MAX_AGE_MS=3600000
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SAME_SITE=lax

# LLM: `ollama` (default) or `groq`
LLM_PROVIDER=ollama

# OLLAMA (when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_API_KEY=sk-proj-1234567890

# GROQ (when LLM_PROVIDER=groq)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Max upload size for flashcard document generation (bytes). Default: 10 MB.
FILE_UPLOAD_MAX_BYTES=10485760

# CORS ORIGINS

# Allowed frontend origin(s), separated by commas.
WEB_ORIGIN=http://localhost:3001
# Backward-compatible fallback key for older config.
CORS_ORIGIN=http://localhost:3001