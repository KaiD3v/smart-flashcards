# Public base URL of the SmartFlashcards backend API.
# Must be reachable from the browser. In production, prefer same-origin
# (e.g. https://app.smartflashcards.com/api) so the auth cookie can be sent.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional: name of the auth cookie set by the backend.
# Must match server's AUTH_COOKIE_NAME (defaults to access_token).
NEXT_PUBLIC_AUTH_COOKIE_NAME=access_token

# Optional: site name displayed in the UI.
NEXT_PUBLIC_SITE_NAME=SmartFlashcards
