# Public API base used by the browser.
# Use /api with Next.js rewrite proxy to keep auth cookie same-origin.
NEXT_PUBLIC_API_URL=/api

# Upstream API target for Next.js rewrite proxy.
NEXT_API_PROXY_TARGET=https://smart-flashcards-production.up.railway.app

# Optional: name of the auth cookie set by the backend.
# Must match server's AUTH_COOKIE_NAME (defaults to access_token).
NEXT_PUBLIC_AUTH_COOKIE_NAME=access_token

# Optional: site name displayed in the UI.
NEXT_PUBLIC_SITE_NAME=MyRemynd

# Public site URL for canonical links, Open Graph, and sitemap (production: https://myremynd.com).
NEXT_PUBLIC_SITE_URL=https://myremynd.com

# Optional: Google Search Console verification ID.
GOOGLE_VERIFICATION_ID=
